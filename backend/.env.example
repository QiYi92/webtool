# PostgreSQL 连接串（Supabase/自建 PG 都可以）
DATABASE_URL=postgresql+psycopg2://postgres:password@host:5432/postgres

# JWT 配置
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# DSA 系统单点登录。此密钥只供工具站后端与 DSA 容器共享，不能与 JWT_SECRET 相同。
DSA_SSO_SECRET=replace-with-another-long-random-secret
DSA_SSO_TTL_SECONDS=60

# 允许跨域来源，多个用英文逗号分隔
# 示例：CORS_ALLOW_ORIGINS=http://1.2.3.4:3000,https://example.com
CORS_ALLOW_ORIGINS=http://localhost:3000

# Bangumi 爬虫网络配置。
# 如果服务器无法直连 bgm.tv / bangumi.tv，可填写 HTTP/SOCKS 代理。
# 示例：BANGUMI_PROXY=http://127.0.0.1:7890
# 示例：BANGUMI_PROXY=socks5h://127.0.0.1:7890（需额外安装 requests[socks]）
BANGUMI_PROXY=
# 是否允许 requests 读取容器环境中的 HTTP_PROXY/HTTPS_PROXY/NO_PROXY。
BANGUMI_TRUST_ENV_PROXY=0
# 连接/读取超时秒数。
BANGUMI_CONNECT_TIMEOUT=8
BANGUMI_READ_TIMEOUT=20

# Stock_Screen_demo 项目根目录。Docker Compose 默认挂载到此路径。
STOCK_SCREEN_ROOT=/opt/stock_screen
