# 前端在浏览器里调用后端 API 的地址（会在 build 时写入前端代码）
# 如果直接开放端口：填写 http://你的服务器公网IP:8888
NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP:8888

# 后端 CORS 放行来源（前端访问地址）
FRONTEND_PUBLIC_ORIGIN=http://YOUR_SERVER_IP:3000

# FRED 官方 API Key（用于投资气象站数据拉取）
FRED_API_KEY=YOUR_FRED_API_KEY

# DSA 独立服务使用同一个 Supabase PostgreSQL，但仅访问 dsa_* 表。
# 先手动执行 docs/database/dsa-supabase-schema.sql，再启动 DSA 容器。
DSA_DATABASE_URL=postgresql+psycopg2://postgres:password@host:5432/postgres
DSA_SSO_SECRET=replace-with-another-long-random-secret
# 生产 HTTPS 保持 true；仅本地 http://localhost 调试时改为 false。
DSA_COOKIE_SECURE=true
